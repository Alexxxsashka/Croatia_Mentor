generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  password       String?
  role           String    @default("user")
  phone          String?
  nativeLanguage String    @default("en")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  accounts       Account[]
  sessions       Session[]
  progress       Progress?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Progress {
  id                 String    @id @default(cuid())
  userId             String    @unique
  currentLevel       String    @default("A1")
  totalXP            Int       @default(0)
  currentStreak      Int       @default(0)
  longestStreak      Int       @default(0)
  totalWordsLearned  Int       @default(0)
  totalWordsReviewed Int       @default(0)
  lastActivityDate   DateTime  @default(now())
  lastLessonCompletedAt DateTime?
  completedLessons   String[]  @default([])
  testScores         Json      @default("[]")
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WordProgress {
  id           String    @id @default(cuid())
  userId       String
  wordHr       String
  status       String    @default("new") // new, learning, learned, mastered
  correctCount Int       @default(0)
  wrongCount   Int       @default(0)
  lastReviewed DateTime?
  nextReview   DateTime?
  easeFactor   Float     @default(2.5)
  interval     Int       @default(1)
  repetitions  Int       @default(0)

  @@unique([userId, wordHr])
  @@index([userId, status])
  @@index([userId, nextReview])
}

model DailyActivity {
  id               String  @id @default(cuid())
  userId           String
  date             String  // YYYY-MM-DD
  wordsLearned     Int     @default(0)
  wordsReviewed    Int     @default(0)
  lessonsCompleted Int     @default(0)
  testsCompleted   Int     @default(0)
  xpEarned         Int     @default(0)
  minutesSpent     Int     @default(0)
  chatCount        Int     @default(0)
  completed        Boolean @default(false)

  @@unique([userId, date])
  @@index([userId, date])
}

model UserSettings {
  id                   String  @id @default(cuid())
  userId               String  @unique
  dailyGoalMinutes     Int     @default(10)
  reminderEnabled      Boolean @default(true)
  reminderTime         String  @default("09:00")
  notificationsEnabled Boolean @default(false)

  @@index([userId])
}

model Lesson {
  id      String @id @default(cuid())
  type    String // grammar, reading, dictation, communication
  title   String
  content Json
  level   String // A1, A2, B1, B2, C1, C2
}

model Flashcard {
  id             String  @id @default(cuid())
  wordHr         String
  translationEng String
  translationRu  String
  translationUa  String
  mediaUrl       String?
  level          String  @default("A1")
  category       String  @default("general")
}

model Changelog {
  id        String   @id @default(cuid())
  version   String
  titleEn   String
  titleRu   String
  titleUa   String
  contentEn String   @db.Text
  contentRu String   @db.Text
  contentUa String   @db.Text
  createdAt DateTime @default(now())
}

